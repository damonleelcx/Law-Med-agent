/* After the web app's chat (web/src/styles/app.css: .chat, .msg, .composer). */
.chat {
  min-height: 0;
  display: flex;
  flex-direction: column;
  height: 100vh;
}
.bar {
  padding: 16rpx 32rpx 0;
  text-align: center;
}
.scroll {
  flex: 1;
  min-height: 0;
}
.thread {
  padding: 32rpx 28rpx 12rpx;
  display: flex;
  flex-direction: column;
  gap: 44rpx;
}

/* Empty state */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 48rpx 24rpx;
}
.portrait {
  width: 220rpx;
  height: 220rpx;
  border-radius: 64rpx;
  overflow: hidden;
  border: 8rpx solid var(--surface);
  box-shadow: var(--shadow-lg);
  margin-bottom: 44rpx;
  animation: float 6s ease-in-out infinite;
  background: var(--face-bg);
}
.portrait image {
  width: 100%;
  height: 100%;
}
.hello {
  font-size: 52rpx;
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.15;
  margin-bottom: 20rpx;
}
.hello-sub {
  color: var(--text-2);
  font-size: 30rpx;
  line-height: 1.6;
  margin-bottom: 52rpx;
}
.suggest {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 20rpx;
}
.chip-btn {
  border: 1rpx solid var(--line-strong);
  background: var(--surface);
  border-radius: 999rpx;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
}
.chip-btn-hover {
  border-color: var(--ember-500);
  box-shadow: var(--shadow-sm);
}

/* Messages */
.msg.user {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}
.msg.user .bubble {
  font-size: var(--fs);
  max-width: 82%;
  background: var(--user-bubble);
  color: var(--user-ink);
  padding: 22rpx 30rpx;
  border-radius: 40rpx 40rpx 12rpx 40rpx;
  white-space: pre-wrap;
  word-break: break-word;
  line-height: 1.55;
}
.fail {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  border-radius: 50%;
  background: var(--rose-500);
  color: #fff;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 16rpx;
  flex: none;
}
.msg.vera {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}
.face {
  width: 68rpx;
  height: 68rpx;
}
.body {
  flex: 1;
  min-width: 0;
}
.name {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-2);
  margin: 4rpx 0 8rpx;
}
.ai-tag {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-2);
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  padding: 2rpx 14rpx;
  border-radius: 99rpx;
  letter-spacing: 1rpx;
}
.em-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #b3261e;
  background: rgba(216, 72, 59, 0.12);
  padding: 4rpx 16rpx;
  border-radius: 99rpx;
}
.em-tag image {
  width: 24rpx;
  height: 24rpx;
}
.prose {
  line-height: 1.68;
  font-size: calc(var(--fs) + 1rpx);
  word-break: break-word;
}
.msg.vera.emergency .prose {
  background: rgba(216, 72, 59, 0.1);
  border: 1rpx solid rgba(216, 72, 59, 0.3);
  padding: 22rpx 26rpx;
  border-radius: 28rpx;
}
.msg.vera.update .prose {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 22rpx 30rpx;
}
.copy {
  display: inline-block;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 8rpx 0;
}
.typing {
  display: flex;
  gap: 10rpx;
  padding: 22rpx 0;
}
.typing view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--ember-500);
  animation: blink 1.2s infinite;
}
.typing view:nth-child(2) {
  animation-delay: 0.15s;
}
.typing view:nth-child(3) {
  animation-delay: 0.3s;
}
.end {
  height: 8rpx;
}

/* Composer */
.composer-wrap {
  padding: 16rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
}
.composer {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  background: var(--surface);
  border: 1rpx solid var(--line-strong);
  border-radius: 44rpx;
  padding: 14rpx 14rpx 14rpx 30rpx;
  box-shadow: var(--shadow-md);
}
.box {
  flex: 1;
  min-height: 44rpx;
  max-height: 300rpx;
  padding: 16rpx 0;
  font-size: calc(var(--fs) + 1rpx);
  line-height: 1.5;
  color: var(--text);
}
.ph {
  color: var(--text-3);
}
.send {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background: var(--ember-500);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  transition: opacity 0.2s;
}
.send.off {
  opacity: 0.35;
}
.send image {
  width: 36rpx;
  height: 36rpx;
}
.note {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.5;
}

/* Attach, upload note, inline approvals (web .attach, .upload-note, .approval) */
.attach {
  width: 72rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.attach image {
  width: 40rpx;
  height: 40rpx;
}
.composer {
  padding-left: 10rpx !important;
}
.upload-note {
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
  margin-bottom: 12rpx;
}
.ap-wrap {
  margin-left: 88rpx;
}

/* Voice: hold-to-talk mic (in place of send while the box is empty), the
   listening card, and 朗读 beside 复制. */
.acts {
  display: flex;
  gap: 28rpx;
}
.speak {
  display: inline-block;
  color: var(--text-3);
  font-size: 24rpx;
  padding: 8rpx 0;
}
.speak.on {
  color: var(--ember-500);
  font-weight: 600;
}
.send.mic.rec {
  transform: scale(1.12);
  box-shadow: 0 0 0 12rpx rgba(232, 102, 42, 0.18);
}
.voice-overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 50;
}
.voice-card {
  background: rgba(28, 26, 23, 0.86);
  color: #fff;
  border-radius: 32rpx;
  padding: 44rpx 56rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  min-width: 320rpx;
}
.voice-card.cancel {
  background: rgba(216, 72, 59, 0.92);
}
.voice-dot {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--ember-500);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: voice-pulse 1.2s ease-in-out infinite;
}
.voice-card.cancel .voice-dot {
  background: rgba(255, 255, 255, 0.2);
  animation: none;
}
.voice-dot image {
  width: 52rpx;
  height: 52rpx;
}
.voice-t {
  font-size: 30rpx;
  font-weight: 600;
}
.voice-sub {
  font-size: 24rpx;
  opacity: 0.75;
}
@keyframes voice-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(232, 102, 42, 0.55); }
  50% { box-shadow: 0 0 0 22rpx rgba(232, 102, 42, 0); }
}
