.hello {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 44rpx 36rpx 36rpx;
  gap: 24rpx;
}
.hello .btn {
  width: 100%;
}
.face {
  width: 120rpx;
  height: 120rpx;
  border-radius: 34rpx;
}
.hello-text {
  color: var(--text-2);
  font-size: 28rpx;
}
.profile {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 32rpx;
}
/* The web app's .me-avatar */
.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--ember-400), var(--ember-600));
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}
.who {
  min-width: 0;
}
.nm {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
}
.role {
  display: block;
  font-size: 24rpx;
  margin-top: 6rpx;
}
.list {
  margin-top: 28rpx;
  overflow: hidden;
}
.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 30rpx 32rpx;
  border-bottom: 1rpx solid var(--line);
}
.item:last-child {
  border-bottom: 0;
}
.item-hover {
  background: var(--surface-2);
}
.ic {
  width: 40rpx;
  color: var(--ember-600);
  font-weight: 700;
  text-align: center;
}
.lbl {
  flex: 1;
  font-weight: 600;
}
.val {
  color: var(--text-2);
  font-weight: 700;
}
.chev {
  color: var(--text-3);
  font-size: 40rpx;
  line-height: 1;
}
.out {
  margin-top: 40rpx;
  width: 100%;
}
.foot {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}
