<view class="root {{ui}}">
<view class="page">
  <view class="card balance-card">
    <image class="vface face" src="/images/vera-face-{{balance === 0 ? 'think' : 'smile'}}.webp" webp mode="aspectFill" />
    <view class="label">{{s.balance}}</view>
    <block wx:if="{{signedIn && enabled}}">
      <view class="balance">✉ {{balance === null ? '—' : balance}}</view>
      <view class="chip">{{s.perMessage}}</view>
    </block>
    <block wx:elif="{{signedIn}}">
      <view class="off">{{s.payOff}}</view>
    </block>
    <block wx:else>
      <view class="balance muted">✉ —</view>
      <button class="btn btn-ink signin" hover-class="btn-hover" bindtap="signIn">{{s.loginToSeeBalance}}</button>
    </block>
  </view>

  <block wx:if="{{enabled}}">
    <view class="section muted">{{s.packs}}</view>
    <view class="packs">
      <view wx:for="{{packs}}" wx:key="*this" class="pack {{buying ? 'busy' : ''}}" hover-class="pack-hover" data-qty="{{item}}" bindtap="buy">
        <view class="qty">✉ {{item}}</view>
        <view class="cta">{{s.buy}}</view>
      </view>
    </view>
    <view class="why">{{s.stampsWhy}}</view>

    <block wx:if="{{ledger.length}}">
      <view class="section muted">{{s.history}}</view>
      <view class="card ledger">
        <view wx:for="{{ledger}}" wx:key="key" class="entry">
          <text>{{item.refunded ? s.refunded : s.charged}}</text>
          <text class="when">{{item.when}}</text>
          <text class="amt {{item.refunded ? 'plus' : ''}}">{{item.refunded ? '+' : '−'}}{{item.amount}}</text>
        </view>
      </view>
    </block>
  </block>
</view>
  <login-sheet id="login" bind:login="onLogin" />
</view>
