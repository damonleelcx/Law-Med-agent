.top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx;
}
.new {
  margin-left: auto;
  color: var(--green);
  font-size: 30rpx;
  font-weight: 500;
}
.list {
  background: var(--cell);
}
.row {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  position: relative;
}
.row::after {
  content: '';
  position: absolute;
  left: 144rpx;
  right: 0;
  bottom: 0;
  border-bottom: 1rpx solid var(--line);
}
.row-hover {
  background: #ececec;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex: none;
  background: #dfe8e6;
}
.body {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}
.line1 {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.title {
  font-size: 32rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.when {
  font-size: 22rpx;
  flex: none;
  margin-left: 16rpx;
}
.last {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.empty {
  text-align: center;
  padding: 120rpx 48rpx;
}
.foot {
  font-size: 22rpx;
  padding: 32rpx 48rpx 64rpx;
  text-align: center;
  line-height: 1.5;
}
