/* After the web app's sidebar (web/src/styles/app.css: .side, .side-new, .side-list). */
.hero {
  display: flex;
  align-items: center;
  gap: 28rpx;
  background: var(--surface);
  border-radius: 40rpx;
  padding: 28rpx;
  box-shadow: var(--shadow-md);
}
.portrait {
  width: 150rpx;
  height: 150rpx;
  border-radius: 44rpx;
  overflow: hidden;
  flex: none;
  background: var(--face-bg);
  box-shadow: var(--shadow-sm);
}
.portrait image {
  width: 100%;
  height: 100%;
}
.hero-text {
  min-width: 0;
}
.name {
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.tag {
  font-size: 24rpx;
  font-weight: 500;
}
.sub {
  margin-top: 10rpx;
  color: var(--text-2);
  font-size: 26rpx;
  line-height: 1.6;
}
.new {
  margin-top: 32rpx;
  width: 100%;
}
.chips {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}
.section-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.link {
  color: var(--ember-600);
  font-size: 24rpx;
  font-weight: 600;
  padding: 0 8rpx;
}
.search {
  width: 100%;
  margin-bottom: 12rpx;
}
.list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.row {
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
}
.row-hover-bg {
  background: var(--surface);
  box-shadow: var(--shadow-sm);
}
.row-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.when {
  flex: none;
  font-size: 22rpx;
  color: var(--text-3);
}
.last {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--text-3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.empty {
  padding: 24rpx 8rpx;
  font-size: 27rpx;
}
.foot {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: var(--text-3);
  text-align: center;
  line-height: 1.6;
}
