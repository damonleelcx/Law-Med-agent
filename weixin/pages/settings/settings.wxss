.s-row.col {
  flex-direction: column;
  align-items: stretch;
  gap: 18rpx;
}
.inline {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.grow {
  flex: 1;
}
.full {
  width: 100%;
  margin-top: 18rpx;
}
.gap {
  margin-top: 24rpx;
}
.small {
  font-size: 25rpx;
  line-height: 1.6;
}
.lead {
  margin-bottom: 20rpx;
}
.note {
  margin-bottom: 24rpx;
}
.t-big {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: var(--surface-2);
  border: 1rpx solid var(--line-strong);
  border-radius: 20rpx;
}
.danger {
  border-color: rgba(216, 72, 59, 0.3);
}
.usage {
  display: flex;
  justify-content: space-around;
  margin-top: 24rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-2);
}
.u-n {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text);
}
.u-l {
  display: block;
  font-size: 22rpx;
  margin-top: 4rpx;
}
