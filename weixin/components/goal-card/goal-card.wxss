.gc {
  margin: 4rpx 0 0 88rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 36rpx;
  padding: 28rpx 30rpx 26rpx 38rpx;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}
.gc::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--ember-500);
}
.gc.domain-medical::before {
  background: var(--teal-500);
}
.gc.domain-medlegal::before {
  background: linear-gradient(var(--ember-500), var(--teal-500));
}
.gc.domain-legal::before {
  background: var(--navy-800);
}
.gc-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
}
.gc-title {
  min-width: 0;
}
.gc-kicker {
  display: block;
  color: var(--text-3);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.06em;
}
.gc-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  margin-top: 4rpx;
}
.gc-attn {
  font-size: 26rpx;
  margin-top: 18rpx;
  background: rgba(244, 177, 62, 0.14);
  color: #7a5410;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
}
.gc-steps {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.gc-step {
  display: flex;
  align-items: center;
  gap: 18rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
.gc-step-text {
  flex: 1;
  min-width: 0;
}
.gc-step-title {
  display: block;
}
.st-succeeded .gc-step-title {
  color: var(--text-3);
  text-decoration: line-through;
}
.st-leased .gc-step-title {
  color: var(--text);
  font-weight: 600;
}
.gc-step-label {
  flex: none;
  font-size: 22rpx;
  color: var(--text-3);
}
.st-waiting_approval .gc-step-label {
  color: var(--ember-600);
  font-weight: 600;
}
.activity {
  display: block;
  font-size: 22rpx;
  color: var(--ember-600);
  margin-top: 2rpx;
}
.activity.recovering {
  color: #7a5410;
}
.gc-planning {
  color: var(--text-2);
  font-size: 26rpx;
}
.gc-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.gc-link {
  color: var(--ember-600);
  font-weight: 600;
}
